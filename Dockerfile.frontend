# Frontend for WanderTogether Travel App
FROM node:20-slim

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --omit=optional

# Copy source code
COPY . .

# Build frontend
RUN npx vite build

# Install nginx
RUN apt-get update && apt-get install -y nginx && rm -rf /var/lib/apt/lists/*

# Copy built assets to nginx
RUN cp -r dist/public/* /var/www/html/

# Create simple nginx config
RUN echo 'server { listen 80; root /var/www/html; index index.html; location / { try_files $uri $uri/ /index.html; } }' > /etc/nginx/sites-available/default

# Create non-root user
RUN groupadd -r nginx && useradd -r -g nginx nginx
RUN chown -R nginx:nginx /var/www/html /var/log/nginx /var/cache/nginx
USER nginx

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]