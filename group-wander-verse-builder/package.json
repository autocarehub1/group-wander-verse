{
  "name": "group-wander-verse-builder",
  "version": "1.0.0",
  "description": "Travel app build service for React Native applications",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.{js,ts}",
    "docker:build": "docker build -t wander-verse-builder .",
    "k8s:deploy": "kubectl apply -f k8s/"
  },
  "keywords": [
    "travel",
    "react-native",
    "build-service",
    "kubernetes",
    "microservice"
  ],
  "author": "WanderVerse Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "@google-cloud/storage": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "joi": "^17.9.2",
    "winston": "^3.10.0",
    "compression": "^1.7.4",
    "rate-limiter-flexible": "^2.4.2"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "tsx": "^3.12.7",
    "@types/node": "^20.4.5",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/compression": "^1.7.2",
    "jest": "^29.6.2",
    "eslint": "^8.45.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}