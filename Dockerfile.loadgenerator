# Load Generator for WanderTogether Travel App
# Based on Google Cloud microservices-demo loadgenerator pattern

FROM python:3.11-slim

WORKDIR /loadgen

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY loadgenerator/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy load generator scripts
COPY loadgenerator/ .

# Create non-root user
RUN groupadd -r loadgen && useradd -r -g loadgen loadgen
RUN chown -R loadgen:loadgen /loadgen
USER loadgen

# Expose Locust web interface port
EXPOSE 8089

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8089')" || exit 1

# Start Locust with web UI
ENTRYPOINT ["locust", "--host=http://wandertogether-frontend", "--web-host=0.0.0.0", "--web-port=8089"]