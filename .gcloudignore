# Build artifacts - these will be recreated
node_modules/
dist/

# Development and config files not needed in production
.env.local
.env.development
.vscode/
.idea/
*.log
*.tmp

# Documentation and non-essential files
README.md
*.md
!replit.md

# Git files
.git/
.gitignore

# Test files
test/
tests/
spec/
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# Replit specific
.replit
uploads/

# Mobile development (not needed for web deployment)
android/
capacitor.config.ts

# These files ARE needed and will be included:
# package.json
# package-lock.json  
# client/
# server/
# shared/
# vite.config.ts
# tsconfig.json
# tailwind.config.ts
# postcss.config.js